# ---------------------------------------------------------------------------
# UNIVAC ERP - Backend (FastAPI)
# ---------------------------------------------------------------------------
# Copiar este archivo a `.env` y completar los valores.
# NUNCA subir un `.env` real al repositorio.
#
# En produccion (Vercel / servidor / contenedor) se defines como variables
# de entorno del entorno, no como archivo.
# ---------------------------------------------------------------------------

# --- Base de datos MySQL ---------------------------------------------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# URL de conexion completa. Si se define, tiene prioridad sobre las
# variables DB_* anteriores.
# Ejemplo: mysql+pymysql://usuario:clave@host:3306/base
DATABASE_URL=

# --- Seguridad / JWT -------------------------------------------------------
# Clave de firma de los tokens JWT. OBLIGATORIA.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Entorno y CORS --------------------------------------------------------
# "development" | "production"
ENVIRONMENT=development

# Orígenes permitidos, separados por coma. NO puede ser "*".
# Ejemplo produccion: https://app.tu-dominio.com
CORS_ORIGINS=http://localhost:5173
