# ---------------------------------------------------------------------------
# UNIVAC ERP - Frontend (Vite + Vue 3)
# ---------------------------------------------------------------------------
# Copiar este archivo a `.env` (desarrollo) o `.env.production` (produccion)
# y completar los valores. NUNCA subir un `.env` real al repositorio.
#
# En Vercel: Project > Settings > Environment Variables > (*)
#   VITE_API_URL = https://api.tu-dominio.com
# ---------------------------------------------------------------------------

# URL base del backend FastAPI.
# - Vacio => se usan rutas relativas al mismo origen (proxy /api).
# - Ejemplo produccion: https://api.tu-dominio.com
VITE_API_URL=

# Muestra la seccion "Otros informes" (informes no originales).
# "true" o "false" (string).
VITE_SHOW_NO_ORIGINAL=false
